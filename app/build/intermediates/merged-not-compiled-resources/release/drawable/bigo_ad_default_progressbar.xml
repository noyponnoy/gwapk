<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="360">
    <shape
        android:innerRadiusRatio="3.2"
        android:shape="ring"
        android:thicknessRatio="5.2"
        android:useLevel="false">
        <gradient
            android:centerColor="#FF009DFF"
            android:centerX="0.50"
            android:centerY="0.50"
            android:endColor="#FF009DFF"
            android:startColor="#1A009DFF"
            android:type="sweep"
            android:useLevel="false" />
    </shape>
</rotate>