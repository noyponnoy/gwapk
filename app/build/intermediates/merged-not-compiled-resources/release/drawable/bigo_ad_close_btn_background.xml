<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="25dp"
                android:height="25dp" />
            <solid android:color="#33000000" />
            <corners android:radius="12.5dp" />
