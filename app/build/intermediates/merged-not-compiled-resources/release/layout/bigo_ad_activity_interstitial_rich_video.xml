<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <RelativeLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center|top"
        android:orientation="vertical">

        <sg.bigo.ads.api.MediaView
            android:id="@+id/inter_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />

        <Button
            android:id="@+id/inter_btn_mute"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignEnd="@id/inter_media"
            android:layout_alignBottom="@id/inter_media"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bigo_ad_ic_media_mute"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/inter_advertiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="18dp"
            android:layout_marginLeft="18dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/bigo_ad_advertiser_background"
            android:ellipsize="end"
            android:maxWidth="240dp"
            android:maxLines="1"
            android:text="bigoad.com"
            android:textColor="#E9EBEC"
            android:textSize="12sp"
            tools:text="bigoad.com" />

        <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/inter_ad_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:visibility="invisible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:background="@android:color/white"
                android:minHeight="120dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        xmlns:tools="http://schemas.android.com/tools"
                        android:id="@+id/inter_rounded_icon_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        app:bigo_ad_radius="6dp">

                        <ImageView
                            android:id="@+id/inter_icon"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            tools:ignore="ContentDescription" />

                    </sg.bigo.ads.common.view.RoundedFrameLayout>
                    <!--                <ImageView-->
                    <!--                    android:id="@+id/inter_icon"-->
                    <!--                    android:layout_width="80dp"-->
                    <!--                    android:layout_height="80dp"-->
                    <!--                    android:layout_marginStart="12dp"-->
                    <!--                    android:layout_marginTop="16dp"-->
                    <!--                    android:layout_marginBottom="16dp" />-->

                    <TextView
                        android:id="@+id/inter_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12.5dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="12dp"
                        android:layout_toEndOf="@id/inter_rounded_icon_layout"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:lines="2"
                        android:text="@string/bigo_ad_title_default"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/inter_description"
                        android:layout_width="147dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/inter_title"
                        android:layout_alignStart="@id/inter_title"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:layout_toStartOf="@id/inter_btn_cta_layout"
                        android:layout_toEndOf="@id/inter_rounded_icon_layout"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:lines="2"
                        android:text="@string/bigo_ad_description_default"
                        android:textColor="#888888"
                        android:textSize="13sp" />

                    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:layout_below="@id/inter_title"
                        android:id="@+id/inter_btn_cta_layout"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:layout_alignParentEnd="true"
                        app:bigo_ad_radius="6dp">
                        <Button
                            android:id="@+id/inter_btn_cta"
                            android:layout_width="100dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bigo_ad_cta_default"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </sg.bigo.ads.common.view.RoundedFrameLayout>


                    <TextView
                        android:id="@+id/inter_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/inter_rounded_icon_layout"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="16dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="#D8D8D8"
                        android:textSize="13sp"
                        tools:text="Warning Warning Warning" />

                </RelativeLayout>

                <sg.bigo.ads.api.AdOptionsView
                    android:id="@+id/inter_options"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="8dp"
                    android:layout_gravity="bottom|end" />
            </FrameLayout>
        </sg.bigo.ads.common.view.RoundedFrameLayout>

        <!--        <ImageView-->
        <!--            android:id="@+id/inter_ad_label"-->
        <!--            android:layout_width="24dp"-->
        <!--            android:layout_height="24dp"-->
        <!--            android:scaleType="centerInside"-->
        <!--            android:src="@drawable/bigo_ad_ic_ad_label"-->
        <!--            tools:ignore="ContentDescription" />-->
        <TextView
            android:id="@+id/inter_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bigo_ad_tag_background"
            android:gravity="center"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:text="@string/bigo_ad_tag"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            tools:ignore="ContentDescription" />
    </RelativeLayout>
</sg.bigo.ads.api.NativeAdView>
