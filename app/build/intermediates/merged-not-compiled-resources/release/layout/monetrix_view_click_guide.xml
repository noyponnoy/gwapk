<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2000000"
    android:id="@+id/monetrix_layout_click_guide"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/inter_click_guide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <com.monetrix.adsdk.base.view.RoundedFrameLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/inter_rounded_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="40dp"
            app:monetrix_radius="6dp">
            <ImageView
                android:id="@+id/inter_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                tools:ignore="ContentDescription" />

        </com.monetrix.adsdk.base.view.RoundedFrameLayout>

        <Button
            android:id="@+id/inter_btn_cta"
            android:layout_width="match_parent"
            android:layout_height="43.5dp"
            android:layout_below="@+id/inter_rounded_icon_layout"
            android:layout_centerHorizontal="true"
            android:background="@drawable/monetrix_button_bg_rectangle_green"
            android:ellipsize="end"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:maxLines="1"
            android:text="@string/monetrix_cta_default"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:stateListAnimator="@null"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inter_btn_cta"
            android:layout_marginTop="40dp"
            android:visibility="gone" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/inter_click_guide_container"
        android:visibility="gone" />

</RelativeLayout>