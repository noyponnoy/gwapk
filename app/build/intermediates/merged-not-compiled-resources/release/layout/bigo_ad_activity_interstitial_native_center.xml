<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:ignore="ContentDescription">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/inter_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_above="@id/inter_media"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/inter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/inter_icon"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"
            android:layout_toEndOf="@id/inter_icon"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:lines="2"
            android:text="@string/bigo_ad_title_default"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/inter_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inter_title"
            android:layout_alignStart="@id/inter_title"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="20dp"
            android:layout_toEndOf="@id/inter_icon"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lines="2"
            android:text="@string/bigo_ad_description_default"
            android:textColor="#888888"
            android:textSize="13sp" />

        <sg.bigo.ads.ad.interstitial.MaximumHeightMediaView
            android:id="@+id/inter_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <TextView
                android:id="@+id/inter_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="18dp"
                android:layout_marginLeft="18dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bigo_ad_advertiser_background"
                android:ellipsize="end"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:text=""
                android:textColor="#E9EBEC"
                android:textSize="12sp"
                tools:text="" />
        </sg.bigo.ads.ad.interstitial.MaximumHeightMediaView>>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/inter_media"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/inter_btn_cta"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_cta_default"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/inter_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text=""
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                tools:text="Warning Warning Warning" />
        </LinearLayout>

    </RelativeLayout>

<!--    <TextView-->
<!--        android:id="@+id/inter_ad_label"-->
<!--        android:layout_width="17.5dp"-->
<!--        android:layout_height="13dp"-->
<!--        android:layout_gravity="start|bottom"-->
<!--        android:background="#979797"-->
<!--        android:gravity="center"-->
<!--        android:text="Ad"-->
<!--        android:textColor="@android:color/white"-->
<!--        android:textSize="9dp"-->
<!--        tools:ignore="ContentDescription,HardcodedText,SpUsage" />-->
    <TextView
        android:id="@+id/inter_ad_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bigo_ad_tag_background"
        android:gravity="center"
        android:paddingRight="3dp"
        android:paddingLeft="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="@string/bigo_ad_tag"
        android:textColor="#CCFFFFFF"
        android:textSize="9sp"
        tools:ignore="ContentDescription,HardcodedText,SpUsage" />

    <sg.bigo.ads.api.AdOptionsView
        android:id="@+id/inter_options"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="end|bottom" />

</sg.bigo.ads.api.NativeAdView>
