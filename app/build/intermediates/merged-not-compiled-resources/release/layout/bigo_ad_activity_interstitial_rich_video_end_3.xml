<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/inter_layout_end_page"
    android:background="#30000000">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/inter_end_page">
            <ImageView
                android:id="@+id/inter_end_page_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true" />
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/inter_end_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/word_icon_container"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <sg.bigo.ads.common.view.RoundedFrameLayout
                    xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    xmlns:tools="http://schemas.android.com/tools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    app:bigo_ad_radius="6dp">
                    <ImageView
                        android:id="@+id/inter_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        tools:ignore="ContentDescription" />

                </sg.bigo.ads.common.view.RoundedFrameLayout>
<!--                <ImageView-->
<!--                    android:id="@+id/inter_icon"-->
<!--                    android:layout_width="80dp"-->
<!--                    android:layout_height="80dp"-->
<!--                    android:layout_marginTop="24dp"-->
<!--                    android:layout_marginBottom="16dp"-->
<!--                    tools:ignore="ContentDescription" />-->

                <TextView
                    android:id="@+id/inter_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/bigo_ad_title_default"
                    android:textColor="#333333"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/inter_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/bigo_ad_description_default"
                    android:textColor="#888888"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/inter_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxWidth="340dp"
                    android:layout_marginTop="-7dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bigo_ad_advertiser_background"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#ffaeb3b7"
                    android:textSize="12sp"
                    android:text="bigoad.com"
                    tools:text="bigoad.com" />

                <Button
                    android:id="@+id/inter_btn_cta"
                    android:layout_width="match_parent"
                    android:layout_height="43.5dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_cta_default"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/inter_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="24dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="#D8D8D8"
                    android:textSize="13sp"
                    tools:text="Warning Warning Warning" />

            </LinearLayout>

            <TextView
                android:id="@+id/inter_ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bigo_ad_tag_background"
                android:gravity="center"
                android:text="@string/bigo_ad_tag"
                android:textColor="#CCFFFFFF"
                android:paddingRight="3dp"
                android:paddingLeft="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="9sp"
                tools:ignore="ContentDescription" />

            <sg.bigo.ads.api.AdOptionsView
                android:id="@+id/inter_options"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="bottom|end" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/word_icon_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

</RelativeLayout>