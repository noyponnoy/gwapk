<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/inter_layout_end_page"
    android:background="#30000000">

    <FrameLayout
        android:id="@+id/inter_end_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:background="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <com.monetrix.adsdk.base.view.RoundedFrameLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                app:monetrix_radius="6dp">
                <ImageView
                    android:id="@+id/inter_icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    tools:ignore="ContentDescription" />

            </com.monetrix.adsdk.base.view.RoundedFrameLayout>
<!--            <ImageView-->
<!--                android:id="@+id/inter_icon"-->
<!--                android:layout_width="80dp"-->
<!--                android:layout_height="80dp"-->
<!--                android:layout_marginTop="24dp"-->
<!--                android:layout_marginBottom="16dp"-->
<!--                tools:ignore="ContentDescription" />-->

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/monetrix_title_default"
                android:textColor="#333333"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/inter_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/monetrix_description_default"
                android:textColor="#888888"
                android:textSize="13sp" />

            <Button
                android:id="@+id/inter_btn_cta"
                android:layout_width="match_parent"
                android:layout_height="43.5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/monetrix_button_bg_rectangle_green"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/monetrix_cta_default"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inter_layout_playable_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="20dp"
        android:visibility="gone"
        tools:visibility="gone"
        android:layout_below="@id/inter_end_page">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateDrawable="@drawable/monetrix_progressbar_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="Playable ad will be shown soon" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/word_icon_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>