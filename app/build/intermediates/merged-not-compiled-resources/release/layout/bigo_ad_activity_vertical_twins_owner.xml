<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bigo_ad_black">

    <View
        android:id="@+id/bigo_ad_background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/bigo_ad_twins_sub_ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"/>

    <LinearLayout
        android:id="@+id/bigo_ad_bottom_privacy_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom">

        <TextView
            android:id="@+id/inter_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#99999999"
            android:textSize="13sp"
            tools:text="Warning Warning Warning" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/inter_ad_tag_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bigo_ad_multi_img_advertiser_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inter_ad_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingLeft="3dp"
                    android:paddingTop="1dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="1dp"
                    android:text="@string/bigo_ad_tag"
                    android:textColor="#ffffff"
                    android:textSize="9sp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/inter_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:maxLines="1"
                    android:text="bigoad.com"
                    android:textColor="#ffffff"
                    android:textSize="9sp"
                    tools:text="bigoad.com" />

            </LinearLayout>

            <sg.bigo.ads.api.AdOptionsView
                android:id="@+id/inter_options"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="end"/>
        </FrameLayout>

    </LinearLayout>


</FrameLayout>