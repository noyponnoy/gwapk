<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inter_component_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <sg.bigo.ads.common.view.RoundedImageView
        android:id="@+id/inter_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true" />

    <LinearLayout
        android:id="@+id/inter_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/inter_icon"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/inter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/bigo_ad_title_default"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/inter_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/bigo_ad_description_default"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/inter_btn_cta"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:layout_toRightOf="@id/inter_text_layout"
        android:background="#FFFFFFFF"
        android:ellipsize="end"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:text="@string/bigo_ad_cta_default"
        android:textAllCaps="false"
        android:textColor="#FF202124"
        android:textSize="14sp" />

    <sg.bigo.ads.ad.interstitial.multi_img.view.IconListView
        android:id="@+id/inter_download_msg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_below="@id/inter_text_layout" />

</RelativeLayout>
