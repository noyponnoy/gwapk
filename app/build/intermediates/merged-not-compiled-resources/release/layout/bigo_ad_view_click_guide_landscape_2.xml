<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:id="@+id/bigo_ad_layout_click_guide"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/inter_click_guide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/inter_rounded_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="24dp"
            app:bigo_ad_radius="22dp">

            <ImageView
                android:id="@+id/inter_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                tools:ignore="ContentDescription" />

        </sg.bigo.ads.common.view.RoundedFrameLayout>

        <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/inter_btn_cta_layout"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:layout_below="@+id/inter_rounded_icon_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:bigo_ad_radius="8dp">

            <Button
                android:id="@+id/inter_btn_cta"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/bigo_ad_cta_default"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </sg.bigo.ads.common.view.RoundedFrameLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/inter_btn_cta_layout"
            android:layout_marginStart="-70dp"
            android:layout_marginTop="-70dp"
            android:layout_toEndOf="@+id/inter_btn_cta_layout">

            <ImageView
                android:id="@+id/inter_click_guide"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@drawable/bigo_ad_click_guide_landscape"
                tools:ignore="ContentDescription" />

            <View
                android:id="@+id/inter_click_ripple"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:layout_marginStart="38dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bigo_ad_click_ripple" />
        </RelativeLayout>

        <View
            android:id="@+id/inter_icons_center_anchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inter_btn_cta_layout"
            android:layout_marginTop="40dp"
            android:visibility="gone" />
    </RelativeLayout>

    <View
        android:id="@+id/inter_icons_bottom_anchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/inter_click_guide_container"
        android:visibility="gone" />

</RelativeLayout>