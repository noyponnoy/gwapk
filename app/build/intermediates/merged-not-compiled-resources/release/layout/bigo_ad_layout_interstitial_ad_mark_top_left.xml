<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_ad_tag_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="left|center_vertical"
    android:orientation="horizontal"
    android:padding="9.5dp">

    <sg.bigo.ads.api.AdOptionsView
        android:id="@+id/inter_options"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginRight="3.5dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:background="@drawable/bigo_ad_top_left_advertiser_background"
        android:gravity="left|center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/inter_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:gravity="center_vertical"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3.0"
            android:text="@string/bigo_ad_tag"
            android:textColor="#ffffff"
            android:textSize="9sp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/inter_advertiser"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:drawableLeft="@drawable/bigo_ad_domain_left_drawable"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3.0"
            android:text="Bigoad.com"
            android:textColor="#ffffff"
            android:textSize="9sp"
            tools:text="Bigoad.com" />

    </LinearLayout>

</LinearLayout>