<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#fff"
        android:orientation="horizontal"
        tools:ignore="UselessParent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:id="@+id/inter_btn_layout"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/inter_webview_back"
                android:layout_width="40dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:paddingStart="8dp"
                android:paddingLeft="8dp"
                android:paddingEnd="8dp"
                android:paddingRight="8dp"
                android:scaleType="fitXY"
                android:src="@drawable/bigo_ad_ic_back_gray"
                android:tag="@string/bigo_ad_tag_back"
                tools:ignore="ContentDescription,RtlSymmetry" />

            <ImageView
                android:id="@+id/inter_webview_close"
                android:layout_width="40dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:paddingStart="8dp"
                android:paddingLeft="8dp"
                android:paddingEnd="8dp"
                android:paddingRight="8dp"
                android:scaleType="fitXY"
                android:src="@drawable/bigo_ad_ic_close_gray"
                android:tag="@string/bigo_ad_tag_close"
                tools:ignore="ContentDescription,RtlSymmetry" />
        </LinearLayout>

        <TextView
            android:id="@+id/inter_webview_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:tag="@string/bigo_ad_tag_title"
            android:textColor="#333333"
            android:textSize="20sp"
            tools:ignore="RtlSymmetry" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/inter_webview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/inter_webview_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:alpha="0"
            android:max="100"
            android:padding="0dp"
            android:tag="@string/bigo_ad_tag_progressbar" />

        <ViewStub
            android:id="@+id/bigo_web_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/bigo_ad_webview_loading" />

    </FrameLayout>

</LinearLayout>