<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <RelativeLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000">

        <TextView
            android:id="@+id/inter_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginRight="160dp"
            android:layout_marginBottom="20dp"
            android:shadowColor="@color/bigo_ad_black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textColor="#C7999999"
            android:textSize="13sp"
            tools:text="Warning Warning Warning" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/inter_warning"
            android:gravity="center|top"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical">

                            <sg.bigo.ads.common.view.RoundedFrameLayout
                                android:id="@+id/inter_landscape_media_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:bigo_ad_radius="8dp">

                                <sg.bigo.ads.api.MediaView
                                    android:id="@+id/inter_media"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <Button
                                    android:id="@+id/inter_btn_mute"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginRight="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:layout_marginBottom="12dp"
                                    android:layout_gravity="bottom|right"
                                    android:background="@drawable/bigo_ad_ic_media_mute"
                                    android:visibility="invisible" />
                            </sg.bigo.ads.common.view.RoundedFrameLayout>

                        </RelativeLayout>
                    </FrameLayout>

                    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/inter_btn_cta_main_layout"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="24dp"
                        app:bigo_ad_radius="6dp">

                        <Button
                            android:id="@+id/inter_btn_cta_main"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#33FFFFFF"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bigo_ad_cta_default"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </sg.bigo.ads.common.view.RoundedFrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/inter_ad_info"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="invisible">

                        <sg.bigo.ads.common.view.RoundedFrameLayout
                            android:id="@+id/inter_ad_info_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:layout_marginEnd="32dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                                        android:id="@+id/inter_rounded_icon_layout"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="20dp"
                                        android:layout_marginLeft="20dp"
                                        app:bigo_ad_radius="8dp">

                                        <ImageView
                                            android:id="@+id/inter_icon"
                                            android:layout_width="72dp"
                                            android:layout_height="72dp"
                                            tools:ignore="ContentDescription" />
                                    </sg.bigo.ads.common.view.RoundedFrameLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="20dp"
                                        android:layout_marginLeft="20dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/inter_title"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:ellipsize="end"
                                            android:fontFamily="sans-serif-medium"
                                            android:lines="1"
                                            android:text="@string/bigo_ad_title_default"
                                            android:textColor="#FFFFFF"
                                            android:textSize="21sp" />

                                        <TextView
                                            android:id="@+id/inter_company"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:layout_marginEnd="20dp"
                                            android:ellipsize="end"
                                            android:fontFamily="sans-serif-medium"
                                            android:gravity="left"
                                            android:textColor="#FFFFFF"
                                            android:textSize="13sp" />

                                        <TextView
                                            android:id="@+id/inter_description"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:ellipsize="end"
                                            android:maxLines="2"
                                            android:text="@string/bigo_ad_description_default"
                                            android:textColor="#9AFFFFFF"
                                            android:textSize="12sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <sg.bigo.ads.ad.interstitial.multi_img.view.IconListView
                                    android:id="@+id/inter_iconlist_download_msg_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </sg.bigo.ads.common.view.RoundedFrameLayout>
                    </FrameLayout>

                    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/inter_btn_cta_layout"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="24dp"
                        app:bigo_ad_radius="6dp">

                        <Button
                            android:id="@+id/inter_btn_cta"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bigo_ad_cta_default"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </sg.bigo.ads.common.view.RoundedFrameLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <sg.bigo.ads.api.AdOptionsView
            android:id="@+id/inter_options"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="9.5dp"
            android:layout_marginRight="9.5dp"
            android:layout_marginBottom="9.5dp" />

        <TextView
            android:id="@+id/inter_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="7dp"
            android:layout_marginLeft="7dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bigo_ad_tag_background"
            android:gravity="center"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:text="@string/bigo_ad_tag"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/inter_advertiser"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8.5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="bigoad.com"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="bigoad.com" />
    </RelativeLayout>
</sg.bigo.ads.api.NativeAdView>
