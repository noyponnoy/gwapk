<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#1C2933">
    <EditText
        android:id="@+id/inter_form_edit_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:background="@drawable/bigo_ad_edit_background_dark"
        android:textColorHint="#607080"
        android:hint="@string/bigo_ad_form_question_hint"
        android:textSize="13sp"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16.5dp"
        android:paddingBottom="16.5dp"
        android:layout_marginTop="7dp"/>
    <TextView
        android:id="@+id/inter_form_edit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#1C2933"
        android:textSize="13sp"
        android:textColor="#DAE6F2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_alignTop="@id/inter_form_edit_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="-8dp"/>
    <TextView
        android:id="@+id/inter_form_edit_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#FF4D6A"
        android:layout_below="@id/inter_form_edit_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:visibility="gone"/>
</RelativeLayout>