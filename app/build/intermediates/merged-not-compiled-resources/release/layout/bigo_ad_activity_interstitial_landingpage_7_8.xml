<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/inter_webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ViewStub
        android:id="@+id/bigo_web_loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/bigo_ad_webview_loading"/>

    <ImageView
        android:id="@+id/inter_webview_close"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_gravity="start"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:padding="3dp"
        android:scaleType="fitXY"
        android:background="@drawable/bigo_ad_close_btn_background"
        android:src="@drawable/bigo_ad_ic_close"
        android:tag="@string/bigo_ad_tag_close"/>


</FrameLayout>