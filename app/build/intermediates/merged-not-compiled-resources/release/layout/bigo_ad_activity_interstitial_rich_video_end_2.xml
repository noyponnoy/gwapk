<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/inter_layout_end_page"
    android:background="#30000000">

    <FrameLayout
        android:id="@+id/inter_end_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentBottom="false"
        android:background="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <sg.bigo.ads.common.view.RoundedFrameLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                app:bigo_ad_radius="6dp">
                <ImageView
                    android:id="@+id/inter_icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    tools:ignore="ContentDescription" />

            </sg.bigo.ads.common.view.RoundedFrameLayout>


            <TextView
                android:id="@+id/inter_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_title_default"
                android:textColor="#333333"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/inter_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_description_default"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/inter_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="340dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bigo_ad_advertiser_background"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#ffaeb3b7"
                android:textSize="12sp"
                android:text="bigoad.com"
                tools:text="bigoad.com" />

            <RelativeLayout
                android:id="@+id/bigo_ad_btn_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_below="@+id/inter_description"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:padding="10dp">

                <Button
                    android:id="@+id/inter_btn_cta_main"
                    android:layout_width="168dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bigo_ad_button_bg_rectangle_green"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_cta_default"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/inter_btn_cta"
                    android:layout_width="168dp"
                    android:layout_height="44dp"
                    android:layout_toRightOf="@+id/inter_btn_cta_main"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_cta_default"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/inter_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text=""
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                tools:text="Warning Warning Warning" />

        </LinearLayout>

        <TextView
            android:id="@+id/inter_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bigo_ad_tag_background"
            android:gravity="center"
            android:text="@string/bigo_ad_tag"
            android:textColor="#CCFFFFFF"
            android:paddingRight="3dp"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textSize="9sp"
            tools:ignore="ContentDescription" />

        <sg.bigo.ads.api.AdOptionsView
            android:id="@+id/inter_options"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inter_layout_playable_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/inter_end_page"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateDrawable="@drawable/bigo_ad_progressbar_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:maxLines="1"
            android:text="Playable ad will be shown soon"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/word_icon_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>