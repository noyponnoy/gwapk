<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_layout_end_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/inter_end_page"
        android:background="@drawable/bigo_ad_interstitial_rich_video_end_landscape_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:bigo_ad_radius="22dp">

                <ImageView
                    android:id="@+id/inter_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    tools:ignore="ContentDescription" />
            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="311dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_title_default"
                android:textColor="#000000"
                android:textSize="21.5sp" />

            <TextView
                android:id="@+id/inter_description"
                android:layout_width="311dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_description_default"
                android:textColor="#000000"
                android:textSize="13sp" />

            <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/inter_btn_end_page_cta_layout"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                app:bigo_ad_radius="8dp">

                <Button
                    android:id="@+id/inter_btn_cta"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_cta_default"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <LinearLayout
                android:id="@+id/inter_layout_playable_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateDrawable="@drawable/bigo_ad_progressbar_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="Playable ad will be shown soon"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/inter_advertiser"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:layout_marginTop="-7dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bigo_ad_advertiser_background"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="340dp"
            android:maxLines="1"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:text="bigoad.com"
            android:textColor="#ffaeb3b7"
            android:textSize="12sp"
            tools:text="bigoad.com" />

        <TextView
            android:id="@+id/inter_warning"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textColor="#D8D8D8"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Warning Warning Warning" />

        <TextView
            android:id="@+id/inter_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@drawable/bigo_ad_tag_background"
            android:gravity="center"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:text="@string/bigo_ad_tag"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            tools:ignore="ContentDescription" />

        <sg.bigo.ads.api.AdOptionsView
            android:id="@+id/inter_options"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="9.5dp" />
    </FrameLayout>
</FrameLayout>