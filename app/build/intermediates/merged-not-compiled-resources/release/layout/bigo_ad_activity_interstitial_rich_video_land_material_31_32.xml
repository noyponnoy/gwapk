<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inter_native_ad_view"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/native_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/inter_media_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_media_blur_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"/>

            <View
                android:id="@+id/iv_media_blur_bg_mask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#66000000"/>

            <sg.bigo.ads.api.MediaView
                android:id="@+id/inter_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <View
                android:id="@+id/bigo_ad_mask_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bigo_ad_multi_img_vertical_mask"/>

            <LinearLayout
                android:id="@+id/bigo_ad_material_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/bigo_ad_inter_gp_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:orientation="horizontal">

                    <sg.bigo.ads.common.view.RoundedImageView
                        android:id="@+id/inter_icon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/inter_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:text="@string/bigo_ad_title_default"
                            android:textColor="#202124"
                            android:textSize="21.5sp" />

                        <TextView
                            android:id="@+id/inter_company"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Google.Inc"
                            android:textColor="#1B8863"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/inter_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/bigo_ad_description_default"
                            android:textColor="#5F6367"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <sg.bigo.ads.ad.interstitial.multi_img.view.IconListView
                    android:id="@+id/download_msg_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="50dp"
                    android:layout_marginTop="20dp"/>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:id="@+id/inter_btn_cta_layout"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    app:bigo_ad_radius="8dp">

                    <Button
                        android:id="@+id/inter_btn_cta"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FF1B8863"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bigo_ad_cta_default"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:id="@+id/fl_multi_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:bigo_ad_radius="4dp">
                    
                    <ImageView
                        android:id="@+id/iv_blur_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"/>

                    <View
                        android:id="@+id/iv_blur_bg_mask"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#66000000"/>

                    <HorizontalScrollView
                        android:id="@+id/bigo_ad_scroll_images"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:scrollbars="none" />
                </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.YandexWarningTextView
                    android:id="@+id/inter_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:textColor="#59888888"
                    app:bigo_ad_maxTextSize="100sp"
                    app:bigo_ad_minTextSize="10sp"
                    android:textScaleX="0.3"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:gravity="top"
                    tools:text="Warning Warning Warning"/>

                <LinearLayout
                    android:id="@+id/ll_native_extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp">

                        <TextView
                            android:id="@+id/tv_gp_info_extra_about"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center_vertical"
                            android:text="@string/bigo_ad_about_app_default"
                            android:textColor="#202124"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iv_gp_info_extra_arrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="right|center_vertical"
                            android:background="@drawable/bigo_ad_mid_page_ic_gp_right" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_desc_below"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/bigo_ad_description_default"
                        android:ellipsize="end"
                        android:textColor="#63666B"
                        android:textSize="13sp" />

                    <sg.bigo.ads.common.view.AutoNextLineLinearLayout
                        android:id="@+id/fbl_genre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="20dp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <sg.bigo.ads.api.AdOptionsView
            android:id="@+id/inter_options"
            android:layout_width="16dp"
            android:layout_height="16dp"
            tools:background="@color/bigo_ad_black"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/bigo_ad_label_advertiser_background_raduis7"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inter_ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/bigo_ad_tag"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/inter_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:maxLines="1"
                android:text="bigoad.com"
                android:textColor="#E9EBEC"
                android:textSize="9sp"
                tools:text="bigoad.com" />

        </LinearLayout>

    </LinearLayout>

</sg.bigo.ads.api.NativeAdView>