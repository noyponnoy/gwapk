<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/click_guide_container"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_alignEnd="@id/bigo_ad_splash_btn_cta"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="-16dp"
    android:elevation="2dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/click_gesture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:src="@drawable/bigo_ad_click_guide"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/click_ripple"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="center"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/bigo_ad_click_ripple"
        android:visibility="invisible" />
</FrameLayout>