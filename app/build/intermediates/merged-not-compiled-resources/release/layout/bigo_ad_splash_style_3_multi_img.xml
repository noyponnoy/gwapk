<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_contain_view">

    <LinearLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:bigo_ad_shadowColor="#29000000"
                app:bigo_ad_shadowRadius="8dp"
                app:bigo_ad_radius="8dp">

                <ImageView
                    android:id="@+id/bigo_ad_splash_icon"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:clickable="true"
                    android:focusable="true"
                    tools:src="@drawable/bigo_ad_ic_close_gray" />

            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <TextView
                android:id="@+id/bigo_ad_splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:lines="1"
                android:text="@string/bigo_ad_title_default"
                android:textColor="#333333"
                android:textSize="20sp" />

        </LinearLayout>

        <sg.bigo.ads.common.view.ViewFlow
            android:id="@+id/inter_media_ad_view_flow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <sg.bigo.ads.common.view.Indicator
            android:id="@+id/vf_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <include layout="@layout/bigo_ad_splash_style_3_item_cta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="9.5dp"
            android:layout_marginRight="9.5dp"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="4dp">

            <include
                layout="@layout/bigo_ad_splash_ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom" />

            <TextView
                android:id="@+id/inter_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text=""
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                tools:text="Warning Warning Warning"
                android:layout_gravity="center_vertical"
                tools:background="@color/bigo_ad_black"/>

            <sg.bigo.ads.api.AdOptionsView
                android:id="@+id/bigo_ad_splash_options"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="end|bottom"
                tools:background="@color/bigo_ad_black"/>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>