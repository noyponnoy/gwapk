<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/inter_native_ad_view"
    tools:ignore="ContentDescription">
    <LinearLayout
        android:id="@+id/media_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">
        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:id="@+id/inter_media_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:bigo_ad_radius="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#ffffff"
                android:gravity="center">
                <include layout="@layout/bigo_ad_pop_up_ad_msg"
                    android:id="@+id/inter_popup_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7.5dp"
                    android:layout_marginStart="7.5dp"
                    android:layout_marginEnd="100dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/inter_popup_msg"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">
                    <sg.bigo.ads.common.view.RoundedFrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:id="@+id/inter_media_rounded"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:bigo_ad_radius="8dp">
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <sg.bigo.ads.api.MediaView
                                android:id="@+id/inter_media"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minWidth="200dp"
                                android:minHeight="100dp" />
                            <Button
                                android:id="@+id/inter_btn_mute"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignEnd="@id/inter_media"
                                android:layout_alignBottom="@id/inter_media"
                                android:layout_marginEnd="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/bigo_ad_ic_media_mute"
                                android:visibility="invisible" />
                            <sg.bigo.ads.common.view.YandexWarningTextView
                                android:id="@+id/inter_warning"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:layout_alignBottom="@id/inter_media"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="10dp"
                                android:textColor="#99ffffff"
                                android:shadowColor="#33000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="3.0"
                                app:bigo_ad_maxTextSize="130sp"
                                app:bigo_ad_minTextSize="10sp"
                                android:textScaleX="0.3"
                                android:maxLines="2"
                                tools:text="Warning Warning Warning" />
                        </RelativeLayout>
                    </sg.bigo.ads.common.view.RoundedFrameLayout>
                    <TextView
                        android:id="@+id/inter_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="left"
                        android:lines="1"
                        android:text="@string/bigo_ad_title_default"
                        android:textColor="#202124"
                        android:textSize="18sp" />
                    <LinearLayout
                        android:id="@+id/btn_class"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp"
                        android:orientation="horizontal">
                        <include layout="@layout/bigo_ad_popup_close_btn"
                            android:id="@+id/inter_popup_close_btn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>

                        <sg.bigo.ads.common.view.RoundedFrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:id="@+id/inter_btn_cta_layout"
                            android:layout_marginStart="10dp"
                            app:bigo_ad_radius="6dp">
                            <Button
                                android:id="@+id/inter_btn_cta"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/bigo_ad_cta_default"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />
                        </sg.bigo.ads.common.view.RoundedFrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </sg.bigo.ads.common.view.RoundedFrameLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/gift_widget"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignStart="@+id/media_layout"
        android:layout_centerVertical="true"
        android:translationY="-28dp"
        android:layout_marginStart="-32dp"
        android:rotation="-15"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/heart_widget"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignEnd="@+id/media_layout"
        android:layout_centerVertical="true"
        android:translationY="28dp"
        android:layout_marginEnd="-32dp"
        android:rotation="15"
        android:visibility="gone"/>
</RelativeLayout>
