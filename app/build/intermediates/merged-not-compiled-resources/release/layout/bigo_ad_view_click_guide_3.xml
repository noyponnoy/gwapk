<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bigo_ad_layout_click_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <RelativeLayout
        android:id="@+id/inter_click_guide_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="60dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/inter_click_guide_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="left|center_vertical"
            android:orientation="horizontal">

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inter_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="left|top"
                    android:maxLines="2"
                    android:text="@string/bigo_ad_title_default"
                    android:textColor="#FF202124"
                    android:textSize="21.5sp" />

                <TextView
                    android:id="@+id/inter_company"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.5dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Google.Inc"
                    android:textColor="#1B8863"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/inter_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_description_default"
                    android:textColor="#FF202124"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/inter_btn_cta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="12dp"
            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bigo_ad_cta_default"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <sg.bigo.ads.ad.interstitial.multi_img.view.IconListView
            android:id="@+id/inter_download_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/inter_btn_cta"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/inter_click_guide_image_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/inter_download_msg"
            android:layout_below="@id/inter_click_guide_title_layout"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_weight="1">

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_click_guide_image_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_click_guide_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

    </RelativeLayout>

    <ViewStub
        android:id="@+id/inter_gesture_zoom_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout="@layout/bigo_ad_layout_gesture_zoom" />

    <ViewStub
        android:id="@+id/inter_gesture_slide_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/bigo_ad_layout_gesture_slide" />

    <include layout="@layout/bigo_ad_layout_interstitial_ad_mark_top_left" />

    <include
        android:id="@+id/inter_warning_layout"
        layout="@layout/bigo_ad_layout_interstitial_ad_warning_bottom" />
</RelativeLayout>