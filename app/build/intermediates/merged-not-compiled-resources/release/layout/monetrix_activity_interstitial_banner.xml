<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_centerInParent="true" >
    <RelativeLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center|top"
        android:background="#000000"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/inter_banner_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.monetrix.adsdk.api.adview.AdOptionsView
                android:id="@+id/inter_options"
                android:layout_width="14dp"
                android:layout_height="14dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:background="@drawable/monetrix_advertiser_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inter_ad_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/monetrix_tag"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:ignore="ContentDescription" />

                <View
                    android:id="@+id/inter_view_stroke"
                    android:layout_width="2dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="3dp"
                    android:layout_height="match_parent"
                    android:background="#33ffffff"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/inter_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="180dp"
                    android:maxLines="1"
                    android:text="advertiser"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="advertiser" />

            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
