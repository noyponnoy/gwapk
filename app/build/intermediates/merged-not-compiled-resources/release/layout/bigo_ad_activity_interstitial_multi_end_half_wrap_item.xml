<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/bigo_ad_inter_layout_end_page"
    android:clipChildren="false"
    android:layout_gravity="center">

    <FrameLayout
        android:id="@+id/bigo_ad_end_page_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/bigo_ad_title_default"
                android:textColor="#333333"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/inter_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_description_default"
                android:textColor="#888888"
                android:textSize="13sp" />

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:id="@+id/inter_btn_cta_layout"
                android:layout_width="match_parent"
                android:clipChildren="false"
                app:bigo_ad_radius="6dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/inter_btn_cta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bigo_ad_cta_default"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </sg.bigo.ads.common.view.RoundedFrameLayout>

        </LinearLayout>

    </FrameLayout>

    <sg.bigo.ads.common.view.RoundedImageView
        android:id="@+id/inter_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:translationY="-100dp"
        tools:background="@drawable/bigo_ad_double_video_play"
        android:layout_gravity="center"/>

</FrameLayout>