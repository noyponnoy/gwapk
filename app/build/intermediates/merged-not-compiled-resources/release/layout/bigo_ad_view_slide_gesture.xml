<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_slide_gesture_contain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
            android:id="@+id/inter_slide_text"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:text="Slide to open"
            android:textColor="#ffffffff"
            android:textSize="16sp"
            android:gravity="center">
        </TextView>

        <ImageView
            android:id="@+id/inter_slide_gesture"
            android:layout_width="100dp"
            android:layout_height="200dp"
            android:layout_below="@+id/inter_slide_text"
            android:src="@drawable/bigo_ad_slide_gesture"
            tools:ignore="ContentDescription" />
    </RelativeLayout>
</FrameLayout>