<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:background="@drawable/bigo_ad_button_countdown_close"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="4dp">

    <TextView
        android:id="@+id/inter_text_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:id="@+id/inter_view_stroke"
        android:layout_width="2dp"
        android:layout_height="24dp"
        android:background="#33ffffff"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bigo_ad_btn_close"
        android:layout_width="44dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/bigo_ad_splash_skip"
        android:textColor="@android:color/white"
        android:textSize="14dp"
        android:visibility="visible"
        tools:ignore="ContentDescription,SpUsage" />

</LinearLayout>