<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bigo_ad_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="35dp"
                android:background="@drawable/bigo_ad_ic_loading_gp" />

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="113dp"
                android:layout_height="20dp"
                android:layout_marginLeft="11.5dp"
                android:layout_marginStart="11.5dp"
                app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:bigo_ad_radius="10dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="21dp"
                app:bigo_ad_radius="10dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="21dp"
                app:bigo_ad_radius="15dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="20dp"
            android:orientation="horizontal">

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginLeft="21dp"
                app:bigo_ad_radius="16dp">

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:orientation="vertical">

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="113dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="3dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="158dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="10dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="113dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="3dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="38dp"
                    android:layout_height="15dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="68dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="5dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="38dp"
                    android:layout_height="15dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="68dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="5dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="38dp"
                    android:layout_height="15dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

                <sg.bigo.ads.common.view.RoundedFrameLayout
                    android:layout_width="68dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="5dp"
                    app:bigo_ad_radius="2dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>
            </LinearLayout>
        </LinearLayout>

        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="35dp"
            android:layout_marginRight="20dp"
            app:bigo_ad_radius="8dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>

        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="38dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="38dp"
            app:bigo_ad_radius="8dp" >

                <View
                    android:layout_width="match_parent"
                    android:background="#F0F3F4"
                    android:layout_height="match_parent"/>
            </sg.bigo.ads.common.view.RoundedFrameLayout>
    </LinearLayout>
</ScrollView>