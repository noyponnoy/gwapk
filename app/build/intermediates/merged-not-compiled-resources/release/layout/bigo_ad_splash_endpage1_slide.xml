<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_contain_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bigo_ad_splash_endpage_bg"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:clipChildren="false">

        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:bigo_ad_radius="6dp">

            <ImageView
                android:id="@+id/inter_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                tools:ignore="ContentDescription" />

        </sg.bigo.ads.common.view.RoundedFrameLayout>

        <TextView
            android:id="@+id/inter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/bigo_ad_title_default"
            android:textColor="#333333"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/inter_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="25dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/bigo_ad_description_default"
            android:textColor="#333333"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layout_playable_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingTop="20dp"
            android:visibility="invisible"
            tools:visibility="visible"
            tools:background="@color/bigo_ad_black">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateDrawable="@drawable/bigo_ad_progressbar_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:text="Playable ad will be shown soon" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/bigo_ad_splash_endpage_item_cta"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"/>

    <TextView
        android:id="@+id/inter_ad_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bigo_ad_tag_background"
        android:layout_gravity="bottom|start"
        android:gravity="center"
        android:text="@string/bigo_ad_tag"
        android:textColor="#CCFFFFFF"
        android:paddingRight="3dp"
        android:paddingLeft="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textSize="9sp"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        tools:ignore="ContentDescription" />

    <sg.bigo.ads.api.AdOptionsView
        android:id="@+id/inter_options"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        tools:background="@color/bigo_ad_black"/>

</FrameLayout>