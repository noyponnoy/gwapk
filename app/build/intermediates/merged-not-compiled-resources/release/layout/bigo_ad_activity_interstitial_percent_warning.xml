<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/inter_ad_info"
        android:visibility="invisible"
        android:orientation="horizontal"/>

    <LinearLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:id="@+id/inter_media_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bigo_ad_radius="8dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="50dp">

            <sg.bigo.ads.api.MediaView
                android:id="@+id/inter_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"/>

            <Button
                android:id="@+id/inter_btn_mute"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:layout_gravity="bottom|right"
                android:background="@drawable/bigo_ad_ic_media_mute"
                android:visibility="invisible" />
        </sg.bigo.ads.common.view.RoundedFrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/inter_ad_info_exclude_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inter_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:lines="1"
                    android:text="@string/bigo_ad_title_default"
                    android:textColor="#333333"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/inter_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lines="2"
                    android:text="@string/bigo_ad_description_default"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <RelativeLayout
                    android:id="@+id/bigo_ad_btn_class"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/inter_btn_cta_main"
                        android:layout_width="168dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bigo_ad_button_bg_rectangle_green"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bigo_ad_cta_default"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <sg.bigo.ads.common.view.RoundedFrameLayout
                        android:layout_width="168dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@+id/inter_btn_cta_main"
                        android:id="@+id/inter_btn_cta_layout"
                        app:bigo_ad_radius="6dp">
                        <Button
                            android:id="@+id/inter_btn_cta"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/bigo_ad_cta_default"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </sg.bigo.ads.common.view.RoundedFrameLayout>
                </RelativeLayout>
            </LinearLayout>

            <sg.bigo.ads.common.view.YandexWarningTextView
                android:id="@+id/inter_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#888888"
                app:bigo_ad_maxTextSize="100sp"
                app:bigo_ad_minTextSize="10sp"
                android:textScaleX="0.3"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:gravity="top"
                tools:text="Warning Warning Warning"
                />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/inter_ad_tag_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <sg.bigo.ads.api.AdOptionsView
            android:id="@+id/inter_options"
            android:layout_width="16dp"
            android:layout_height="16dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/bigo_ad_label_advertiser_background_raduis7"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inter_ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/bigo_ad_tag"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/inter_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:maxLines="1"
                android:text="bigoad.com"
                android:textColor="#E9EBEC"
                android:textSize="9sp"
                tools:text="bigoad.com" />

        </LinearLayout>

    </LinearLayout>

</sg.bigo.ads.api.NativeAdView>