<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/inter_media_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bigo_ad_white">

            <sg.bigo.ads.api.MediaView
                android:id="@+id/inter_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/bigo_ad_sub_bottom_component"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="bottom"
            android:background="@color/bigo_ad_white"
            android:orientation="horizontal"
            android:paddingStart="65dp"
            android:paddingTop="11dp"
            android:paddingEnd="10dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/bigo_ad_title_default"
                android:textColor="#FF333333"
                android:visibility="gone"
                android:textSize="20sp"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/bigo_ad_tv_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/bigo_ad_grey_btn_background"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:text="More"
                android:visibility="gone"
                tools:visibility="visible"
                android:textColor="#FF333333"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <sg.bigo.ads.common.view.RoundedImageView
        android:id="@+id/inter_icon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="25dp"
        tools:src="@drawable/bigo_ad_ic_media_play" />

</merge>