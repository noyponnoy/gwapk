<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true"
    tools:background="#323232">

    <!-- MediaView parent should be FrameLayout to attach Close button -->
    <com.cleveradssolutions.sdk.nativead.CASMediaView
        android:id="@+id/cas_native_media_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/cas_bg_card_liner_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="5dp"
        android:minHeight="100dp"
        android:orientation="vertical"
        android:padding="10dp"
        tools:background="#66333333">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cas_native_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cas_native_headline"
                    style="@style/com.cleveradssolutions.nativeAds.AutoScrollingTextView.Title"
                    android:textColor="#fff"
                    android:textSize="14sp"
                    tools:text="Primary headline text" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cas_native_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textColor="#fff"
                        android:textSize="11sp"
                        tools:drawableLeft="@drawable/cas_star"
                        tools:drawableTint="#4285F4"
                        tools:text="4.5" />

                    <TextView
                        android:id="@+id/cas_native_reviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        tools:text="Reviews" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cas_native_store"
                        style="@style/com.cleveradssolutions.nativeAds.AutoScrollingTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="2dp"
                        android:textColor="#fff"
                        android:textSize="11sp"
                        tools:text="Google Play" />

                    <TextView
                        android:id="@+id/cas_native_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        tools:text="FREE" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cas_native_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/cas_megaphone"
                android:drawablePadding="2dp"
                android:drawableTint="#4285F4"
                android:gravity="center"
                android:maxLines="1"
                android:padding="2dp"
                android:textColor="#4281EA"
                android:textSize="11sp"
                tools:text="Ad" />

            <TextView
                android:id="@+id/cas_native_advertiser"
                style="@style/com.cleveradssolutions.nativeAds.AutoScrollingTextView"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:minWidth="50dp"
                android:paddingHorizontal="3dp"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                tools:text="Advertiser" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.01" />

            <Button
                android:id="@+id/cas_native_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:padding="10dp"
                android:minWidth="120dp"
                android:minHeight="28dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                tools:backgroundTint="#4285F4"
                tools:text="Install" />
        </LinearLayout>

        <TextView
            android:id="@+id/cas_native_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            tools:text="Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text. Long ads body text." />

    </LinearLayout>

</FrameLayout>
