<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_contain_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/bigo_ad_black">

    <LinearLayout
        android:id="@+id/bigo_ad_splash_container_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:id="@+id/bigo_ad_splash_media_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                app:bigo_ad_radius="8dp">

                <sg.bigo.ads.api.MediaView
                    android:id="@+id/bigo_ad_splash_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:id="@+id/bigo_ad_splash_btn_cta_container_round"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                app:bigo_ad_shadowColor="#29000000"
                app:bigo_ad_shadowRadius="10dp"
                app:bigo_ad_radius="12dp">

                <LinearLayout
                    android:id="@+id/layout_cta_widget_inner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bigo_ad_white"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:layout_marginLeft="26dp"
                        android:layout_marginRight="26dp"
                        android:orientation="horizontal">

                        <sg.bigo.ads.common.view.RoundedFrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:bigo_ad_radius="16dp">

                            <ImageView
                                android:id="@+id/bigo_ad_splash_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:focusable="true"
                                tools:src="@drawable/bigo_ad_ic_close_gray" />

                        </sg.bigo.ads.common.view.RoundedFrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginLeft="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/bigo_ad_splash_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:lines="1"
                                android:text="@string/bigo_ad_title_default"
                                android:textColor="#333333"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/bigo_ad_splash_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/bigo_ad_description_default"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                            <ImageView
                                android:id="@+id/splash_rating_star"
                                android:layout_width="wrap_content"
                                android:layout_height="16dp"
                                android:layout_gravity="start"
                                android:layout_marginTop="9dp"
                                android:scaleType="fitStart" />

                        </LinearLayout>

                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/bigo_ad_splash_btn_cta_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/bigo_ad_splash_btn_cta"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginLeft="26dp"
                            android:layout_marginRight="26dp"
                            android:layout_marginBottom="26dp"
                            android:background="@drawable/bigo_ad_button_bg_rectangle_green_radius8"
                            android:clickable="false"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/bigo_ad_cta_default"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <sg.bigo.ads.common.view.RoundedFrameLayout
                            android:id="@+id/bigo_ad_splash_cta_inner"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_alignStart="@id/bigo_ad_splash_btn_cta"
                            android:layout_alignLeft="@id/bigo_ad_splash_btn_cta"
                            android:layout_alignTop="@id/bigo_ad_splash_btn_cta"
                            android:layout_alignEnd="@id/bigo_ad_splash_btn_cta"
                            android:layout_alignRight="@id/bigo_ad_splash_btn_cta"
                            android:layout_alignBottom="@id/bigo_ad_splash_btn_cta"
                            android:visibility="invisible"
                            app:bigo_ad_radius="8dp" />

                    </RelativeLayout>

                </LinearLayout>

            </sg.bigo.ads.common.view.RoundedFrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9.5dp"
            android:layout_marginRight="9.5dp"
            android:layout_marginBottom="8dp">

            <include
                layout="@layout/bigo_ad_splash_ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical" />

            <TextView
                android:id="@+id/inter_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text=""
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                tools:text="Warning Warning Warning"
                android:layout_gravity="center_vertical"
                tools:background="@color/bigo_ad_black"/>

            <sg.bigo.ads.api.AdOptionsView
                android:id="@+id/bigo_ad_splash_options"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="end|center_vertical" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>