<?xml version="1.0" encoding="utf-8"?>
<com.google.android.play.core.hsdp.service.HsdpLoadingPanelContainer
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:id="@+id/content_frame"
     android:filterTouchesWhenObscured="true"
     android:layout_width="match_parent"
     android:layout_height="wrap_content">
    <include
        layout="@layout/hsdp_service_prism_with_loading_indicator"
        android:id="@+id/placeholder_loading"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/sdk_dismiss_button"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:padding="0dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dismiss_button_description"
        android:scaleType="fitCenter" />
</com.google.android.play.core.hsdp.service.HsdpLoadingPanelContainer>