<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/inter_native_ad_view"
    tools:ignore="ContentDescription">
    <RelativeLayout
        android:id="@+id/media_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_centerVertical="true"
        android:layout_centerInParent="true">
        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:id="@+id/inter_media_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <sg.bigo.ads.api.MediaView
                android:id="@+id/inter_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                android:minHeight="100dp"
                android:layout_centerInParent="true" />
            <include layout="@layout/bigo_ad_pop_up_ad_msg"
                android:id="@+id/inter_popup_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/inter_media"
                android:layout_alignStart="@+id/inter_media"
                android:layout_marginTop="7.5dp"
                android:layout_marginStart="7.5dp"
                android:layout_marginEnd="100dp"/>
        </sg.bigo.ads.common.view.RoundedFrameLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/gift_widget"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignStart="@+id/media_layout"
        android:layout_centerVertical="true"
        android:translationY="-28dp"
        android:layout_marginStart="-32dp"
        android:rotation="-15"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/heart_widget"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignEnd="@+id/media_layout"
        android:layout_centerVertical="true"
        android:translationY="28dp"
        android:layout_marginEnd="-32dp"
        android:rotation="15"
        android:visibility="gone"/>

    <sg.bigo.ads.ad.interstitial.AdCountDownButton
        android:id="@+id/inter_btn_close"
        android:layout_marginTop="-84dp"
        android:layout_below="@+id/media_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bigo_ad_customLayout="@layout/bigo_ad_item_inter_countdown_bg"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
