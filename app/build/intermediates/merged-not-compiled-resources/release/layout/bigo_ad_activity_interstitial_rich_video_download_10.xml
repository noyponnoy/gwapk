<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    tools:ignore="ContentDescription">

    <RelativeLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center|top"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:id="@+id/inter_media_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="40dp"
            app:bigo_ad_shadowColor="#50000000"
            app:bigo_ad_shadowRadius="15dp"
            app:bigo_ad_radius="36dp">
            <sg.bigo.ads.api.MediaView
                android:id="@+id/inter_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </sg.bigo.ads.common.view.RoundedFrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/inter_ad_info"
            android:visibility="invisible"
            android:orientation="horizontal">
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/inter_ad_info_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inter_media_layout"
            android:layout_marginTop="36dp">
            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:id="@+id/inter_ad_info_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/inter_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="40dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:lines="2"
                        android:text="@string/bigo_ad_title_default"
                        android:textAlignment="center"
                        android:textColor="#333333"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/inter_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/inter_title"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/bigo_ad_description_default"
                        android:textAlignment="center"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                    <include
                        android:id="@+id/inter_download_msg"
                        layout="@layout/bigo_ad_download_msg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inter_description"
                        android:layout_centerHorizontal="true"
                        android:visibility="visible" />

                    <RelativeLayout
                        android:id="@+id/bigo_ad_btn_class"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_above="@+id/inter_warning_layout"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center">

                        <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:id="@+id/inter_btn_cta_layout"
                            app:bigo_ad_radius="8dp">
                            <Button
                                android:id="@+id/inter_btn_cta"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                                android:ellipsize="end"
                                android:text="@string/bigo_ad_cta_default"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />
                        </sg.bigo.ads.common.view.RoundedFrameLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@id/inter_warning_layout">

                        <TextView
                            android:id="@+id/inter_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textAlignment="center"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            tools:text="Warning Warning Warning" />

                        <sg.bigo.ads.api.AdOptionsView
                            android:id="@+id/inter_options"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:layout_below="@id/inter_warning"
                            android:layout_alignParentEnd="true" />

                        <include
                            layout="@layout/bigo_ad_label_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_alignBottom="@id/inter_options"
                            android:layout_alignParentStart="true" />
                    </RelativeLayout>


                </RelativeLayout>

            </sg.bigo.ads.common.view.RoundedFrameLayout>

        </RelativeLayout>

    </RelativeLayout>
</sg.bigo.ads.api.NativeAdView>
