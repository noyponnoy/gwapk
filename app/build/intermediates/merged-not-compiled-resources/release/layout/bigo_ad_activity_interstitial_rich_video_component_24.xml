<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <sg.bigo.ads.common.view.RoundedImageView
        android:id="@+id/inter_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true" />

    <LinearLayout
        android:id="@+id/inter_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_toRightOf="@id/inter_icon"
        android:orientation="vertical"
        android:paddingLeft="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="top|left"
             android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:text="@string/bigo_ad_title_default"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/inter_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/bigo_ad_description_default"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

        </LinearLayout>


        <ImageView
            android:id="@+id/inter_star"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:scaleType="fitStart"
            android:visibility="invisible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/inter_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_toRightOf="@id/inter_text_layout"
        android:src="@drawable/bigo_ad_ic_right_black" />

</RelativeLayout>
