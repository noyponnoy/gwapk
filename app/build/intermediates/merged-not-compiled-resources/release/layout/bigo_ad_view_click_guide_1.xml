<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bigo_ad_layout_click_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000">

    <RelativeLayout
        android:id="@+id/inter_click_guide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <sg.bigo.ads.common.view.RoundedImageView
            android:id="@+id/inter_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerHorizontal="true"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/inter_text_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/inter_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_title_default"
                android:textColor="@android:color/white"
                android:textSize="21.5sp" />

            <TextView
                android:id="@+id/inter_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/bigo_ad_description_default"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/inter_btn_cta"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:layout_below="@id/inter_text_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="25dp"
            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
            android:ellipsize="end"
            android:maxLines="1"
            android:stateListAnimator="@null"
            android:text="@string/bigo_ad_cta_default"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <View
            android:id="@+id/inter_icons_center_anchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inter_btn_cta"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

    </RelativeLayout>

    <ViewStub
        android:id="@+id/inter_gesture_zoom_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout="@layout/bigo_ad_layout_gesture_zoom" />

    <ViewStub
        android:id="@+id/inter_gesture_slide_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/bigo_ad_layout_gesture_slide" />

    <include layout="@layout/bigo_ad_layout_interstitial_ad_mark_top_left" />

    <include
        android:id="@+id/inter_warning_layout"
        layout="@layout/bigo_ad_layout_interstitial_ad_warning_bottom" />

    <View
        android:id="@+id/inter_icons_bottom_anchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/inter_warning_layout"
        android:visibility="gone" />

</RelativeLayout>