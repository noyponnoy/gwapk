<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:gravity="center">
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/bigo_ad_success"/>
    <TextView
        android:id="@+id/inter_feedback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textAlignment="center"
        android:textColor="#262E33"
        android:textSize="20sp"/>
    <TextView
        android:id="@+id/inter_feedback_dec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textAlignment="center"
        android:textColor="#9FB0BB"
        android:textSize="13sp"/>
    <Button
        android:id="@+id/inter_feedback_cta"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bigo_ad_btn_background"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="#FFFFFF"/>
</LinearLayout>