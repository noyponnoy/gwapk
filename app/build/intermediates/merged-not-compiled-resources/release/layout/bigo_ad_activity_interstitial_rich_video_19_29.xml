<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="ContentDescription">

    <RelativeLayout
        android:id="@+id/inter_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:id="@+id/inter_media_component"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center|top"
            android:orientation="vertical">

            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:id="@+id/inter_media_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true">

                <sg.bigo.ads.api.MediaView
                    android:id="@+id/inter_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </sg.bigo.ads.common.view.RoundedFrameLayout>

            <Button
                android:id="@+id/inter_btn_mute"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignEnd="@id/inter_media_layout"
                android:layout_alignBottom="@id/inter_media_layout"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bigo_ad_ic_media_mute"
                android:visibility="invisible" />

        </RelativeLayout>

        <include layout="@layout/bigo_ad_layout_interstitial_ad_mark_top_left" />

        <include
            android:id="@+id/inter_warning_layout"
            layout="@layout/bigo_ad_layout_interstitial_ad_warning_bottom" />

        <sg.bigo.ads.common.view.RealtimeBlurLinearLayout
            android:id="@+id/inter_component_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/inter_warning_layout"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="8dp">

            <ViewStub
                android:id="@+id/inter_component_19"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_19" />

            <ViewStub
                android:id="@+id/inter_component_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_20" />

            <ViewStub
                android:id="@+id/inter_component_21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_21" />

            <ViewStub
                android:id="@+id/inter_component_22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_22" />

            <ViewStub
                android:id="@+id/inter_component_23"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_23" />

            <ViewStub
                android:id="@+id/inter_component_24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_24" />

            <ViewStub
                android:id="@+id/inter_component_25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_25" />

            <ViewStub
                android:id="@+id/inter_component_26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout="@layout/bigo_ad_activity_interstitial_rich_video_component_26" />

        </sg.bigo.ads.common.view.RealtimeBlurLinearLayout>

    </RelativeLayout>

</sg.bigo.ads.api.NativeAdView>
