<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.api.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/inter_ad_info"
        android:visibility="invisible"
        android:orientation="horizontal">
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:background="#000000">
        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/inter_media_container"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_above="@+id/inter_other_layout"
            app:bigo_ad_radius="12dp">
            <RelativeLayout
                android:background="#FFFFFF"
                android:id="@+id/inter_ad_info_new"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center|top"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <sg.bigo.ads.common.view.RoundedFrameLayout
                        android:id="@+id/inter_media_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_above="@+id/inter_title"
                        android:layout_below="@+id/inter_rounded_icon_layout"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="28dp"
                        app:bigo_ad_radius="4dp">

                        <sg.bigo.ads.api.MediaView
                            android:id="@+id/inter_media"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true" />
                    </sg.bigo.ads.common.view.RoundedFrameLayout>
                    <LinearLayout
                        android:id="@+id/inter_rounded_icon_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingLeft="20dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="60dp"
                        android:paddingRight="60dp"
                        android:paddingBottom="20dp">

                        <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/bigo_ad_icon_default_radius6"
                            app:bigo_ad_radius="6dp">

                            <ImageView
                                android:id="@+id/inter_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                tools:ignore="ContentDescription" />
                        </sg.bigo.ads.common.view.RoundedFrameLayout>

                        <TextView
                            android:id="@+id/inter_company"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginLeft="16dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="left"
                            android:textColor="#333333"
                            android:textSize="15sp" />
                    </LinearLayout>



                    <TextView
                        android:id="@+id/inter_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/inter_description"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:text="@string/bigo_ad_title_default"
                        android:textColor="#202124"
                        android:textSize="21.5sp" />

                    <TextView
                        android:id="@+id/inter_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@+id/bigo_ad_btn_class"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="left"
                        android:maxLines="2"
                        android:text="@string/bigo_ad_description_default"
                        android:textColor="#5F6367"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:id="@+id/bigo_ad_btn_class"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                            android:id="@+id/inter_btn_cta_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="20dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginRight="20dp"
                            android:layout_marginBottom="16dp"
                            app:bigo_ad_radius="8dp">
                            <Button
                                android:id="@+id/inter_btn_cta"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
                                android:ellipsize="end"
                                android:text="@string/bigo_ad_cta_default"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />
                        </sg.bigo.ads.common.view.RoundedFrameLayout>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
        </sg.bigo.ads.common.view.RoundedFrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="10dp"
            android:paddingBottom="8dp"
            android:id="@+id/inter_other_layout">

            <TextView
                android:id="@+id/inter_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textAlignment="center"
                android:textColor="#999999"
                android:textSize="13sp"
                tools:text="Warning Warning Warning" />

            <sg.bigo.ads.api.AdOptionsView
                android:id="@+id/inter_options"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="8dp"
                android:layout_below="@id/inter_warning"
                android:layout_alignParentEnd="true" />

            <include
                layout="@layout/bigo_ad_label_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_alignBottom="@id/inter_options"
                android:layout_alignParentStart="true" />
        </RelativeLayout>
    </RelativeLayout>

</sg.bigo.ads.api.NativeAdView>