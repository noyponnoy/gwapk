<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_layout_end_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/inter_end_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="60dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_above="@id/word_icon_container">

        <!-- 顶部图标 + 标题 -->
        <LinearLayout
            android:id="@+id/inter_icon_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/bigo_ad_title_default"
                android:textColor="#333333"
                android:textSize="21.5sp" />
        </LinearLayout>

        <!-- 中间可压缩内容区域 -->
        <FrameLayout
            android:id="@+id/inter_end_page_image_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_end_page_image_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_end_page_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- CTA 按钮，固定高度 -->
        <Button
            android:id="@+id/inter_btn_cta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bigo_ad_cta_default"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/word_icon_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />


    <include layout="@layout/bigo_ad_layout_interstitial_ad_mark_top_left" />

    <include
        android:id="@+id/inter_warning_layout"
        layout="@layout/bigo_ad_layout_interstitial_ad_warning_bottom" />
</RelativeLayout>