<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <RelativeLayout
        android:id="@+id/inter_image_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <sg.bigo.ads.common.view.ViewFlow
            android:id="@+id/inter_image_view_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/inter_image_view_flow"
            android:layout_alignEnd="@id/inter_image_view_flow"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:bigo_ad_radius="10dp">
            <sg.bigo.ads.common.view.Indicator
                android:id="@+id/inter_image_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33ffffff"
                android:visibility="invisible" />
        </sg.bigo.ads.common.view.RoundedFrameLayout>
    </RelativeLayout>
    <sg.bigo.ads.common.view.HeightScrollView
        android:id="@+id/inter_form_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/inter_form_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <View
                android:id="@+id/inter_blank_viewholder"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
            <sg.bigo.ads.common.view.RoundedFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                app:bigo_ad_topLeftRadius="8dp"
                app:bigo_ad_topRightRadius="8dp">
                <include layout="@layout/bigo_ad_form_content_dark"/>
                <!--            <include layout="@layout/bigo_ad_form_question" />-->
            </sg.bigo.ads.common.view.RoundedFrameLayout>
        </LinearLayout>
    </sg.bigo.ads.common.view.HeightScrollView>
    <FrameLayout
        android:id="@+id/inter_form_icon_layout"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bigo_ad_icon_background_dark">
        <sg.bigo.ads.common.view.RoundedFrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:bigo_ad_radius="26.5dp">
            <ImageView
                android:id="@+id/inter_form_content_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/bigo_ad_form_icon_back_up" />
        </sg.bigo.ads.common.view.RoundedFrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/inter_form_submit_layout"
        android:layout_width="match_parent"
        android:background="#232F3B"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:layout_alignParentBottom="true">
        <Button
            android:id="@+id/inter_form_submit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#8595A6"
            android:enabled="false"
            android:background="@drawable/bigo_ad_btn_background_white_dark">
        </Button>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/inter_privacy_notice_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <sg.bigo.ads.common.view.RoundedFrameLayout
        android:id="@+id/inter_submit_success_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/inter_image_layout" />
</RelativeLayout>