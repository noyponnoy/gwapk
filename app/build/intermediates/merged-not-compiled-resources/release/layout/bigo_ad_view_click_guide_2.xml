<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bigo_ad_layout_click_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <RelativeLayout
        android:id="@+id/inter_click_guide_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="60dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/inter_click_guide_icon_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/inter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/bigo_ad_title_default"
                android:textColor="@android:color/white"
                android:textSize="21.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/inter_btn_cta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="24dp"
            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bigo_ad_cta_default"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/inter_click_guide_image_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/inter_btn_cta"
            android:layout_below="@id/inter_click_guide_icon_layout"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="24dp">

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_click_guide_image_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <sg.bigo.ads.common.view.RoundedImageView
                android:id="@+id/inter_click_guide_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>


    </RelativeLayout>

    <ViewStub
        android:id="@+id/inter_gesture_zoom_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout="@layout/bigo_ad_layout_gesture_zoom" />

    <ViewStub
        android:id="@+id/inter_gesture_slide_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/bigo_ad_layout_gesture_slide" />

    <include layout="@layout/bigo_ad_layout_interstitial_ad_mark_top_left" />

    <include
        android:id="@+id/inter_warning_layout"
        layout="@layout/bigo_ad_layout_interstitial_ad_warning_bottom" />
</RelativeLayout>