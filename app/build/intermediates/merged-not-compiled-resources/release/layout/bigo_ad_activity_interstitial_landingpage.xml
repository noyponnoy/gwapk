<?xml version="1.0" encoding="utf-8"?>
<sg.bigo.ads.common.view.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inter_landpage_webview_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/inter_webview_top_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bigo_ad_landing_top_bar_bg">

            <ProgressBar
                android:id="@+id/inter_webview_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressDrawable="@drawable/bigo_ad_landing_progress_bar"
                android:tag="@string/bigo_ad_tag_progressbar" />

            <View
                android:id="@+id/inter_webview_top_indicator"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:background="@drawable/bigo_ad_landing_top_indicator" />

            <LinearLayout
                android:id="@+id/inter_webview_top_action_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/inter_webview_top_indicator"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/inter_webview_close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/bigo_ad_ic_close_gray"
                    android:tag="@string/bigo_ad_tag_close"
                    android:visibility="invisible" />


                <LinearLayout
                    android:id="@+id/inter_webview_top_middle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/inter_webview_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="2"
                        android:tag="@string/bigo_ad_tag_title"
                        android:textColor="#FF202124"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/inter_webview_host_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/inter_webview_safe"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginRight="2dp"
                            android:src="@drawable/bigo_ad_ic_safe" />

                        <TextView
                            android:id="@+id/inter_webview_host"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:textColor="#ff65696d"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:id="@+id/inter_webview_open"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/bigo_ad_ic_web_open_browser" />
            </LinearLayout>

        </RelativeLayout>

        <FrameLayout
            android:id="@+id/inter_webview_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:background="@android:color/white" />

        <RelativeLayout
            android:id="@+id/inter_webview_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bigo_ad_landing_bottom_bar_bg">

            <ImageView
                android:id="@+id/inter_webview_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:background="@drawable/bigo_ad_ic_web_back"
                android:enabled="false"
                android:tag="@string/bigo_ad_tag_back" />

            <ImageView
                android:id="@+id/inter_webview_forward"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/inter_webview_back"
                android:background="@drawable/bigo_ad_ic_web_forward"
                android:tag="@string/bigo_ad_tag_forward" />

            <ImageView
                android:id="@+id/inter_webview_copy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bigo_ad_ic_web_copy" />

            <ImageView
                android:id="@+id/inter_webview_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/inter_webview_copy"
                android:background="@drawable/bigo_ad_ic_web_refresh" />
        </RelativeLayout>
    </LinearLayout>

    <ViewStub
        android:id="@+id/bigo_web_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"
        android:layout="@layout/bigo_ad_webview_loading" />

</sg.bigo.ads.common.view.RoundedFrameLayout>
