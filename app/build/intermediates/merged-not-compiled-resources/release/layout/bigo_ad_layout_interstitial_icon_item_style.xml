<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/inter_icon_ads_icon_item_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bigo_ad_radius="8dp">

        <ImageView
            android:id="@+id/inter_icon_ads_item_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            tools:ignore="ContentDescription" />
    </sg.bigo.ads.common.view.RoundedFrameLayout>

    <TextView
        android:id="@+id/inter_icon_ads_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="11sp" />
</LinearLayout>