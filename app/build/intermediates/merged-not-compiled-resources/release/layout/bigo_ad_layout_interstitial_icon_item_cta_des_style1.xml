<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal">

    <sg.bigo.ads.common.view.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/inter_icon_ads_icon_item_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bigo_ad_radius="8dp">

        <ImageView
            android:id="@+id/inter_icon_ads_item_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            tools:ignore="ContentDescription" />
    </sg.bigo.ads.common.view.RoundedFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inter_icon_ads_item_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="BIGO LIVE"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inter_icon_ads_item_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="BIGO LIVE"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/inter_icon_ads_item_btn_cta"
                android:layout_width="88dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Install"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>