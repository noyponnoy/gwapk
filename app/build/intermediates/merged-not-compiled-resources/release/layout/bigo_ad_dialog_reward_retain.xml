<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="48dp"
        android:background="@drawable/bigo_ad_cardview_bg"
        android:clickable="true"
        android:focusable="true"
        tools:ignore="UselessParent">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lines="1"
            android:text="@string/bigo_ad_skip_video"
            android:textColor="#333333"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="10dp"
            android:text="@string/bigo_ad_lose_reward"
            android:textColor="#888888"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bigo_ad_btn_skip"
            android:layout_width="75dp"
            android:layout_height="36dp"
            android:layout_alignTop="@id/bigo_ad_btn_resume"
            android:layout_toStartOf="@id/bigo_ad_btn_resume"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lines="1"
            android:text="@string/bigo_ad_skip"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bigo_ad_btn_resume"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="8dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bigo_ad_button_bg_rectangle_blue"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lines="1"
            android:paddingHorizontal="12dp"
            android:text="@string/bigo_ad_resume"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </RelativeLayout>

</FrameLayout>
