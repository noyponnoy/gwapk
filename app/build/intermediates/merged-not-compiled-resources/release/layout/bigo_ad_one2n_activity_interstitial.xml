<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inter_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/inter_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center|top" />

    <ViewStub
        android:id="@+id/bigo_ad_native_ad_view_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@null"/>

    <LinearLayout
        android:id="@+id/bigo_ad_close_progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <sg.bigo.ads.ad.interstitial.AdCountDownButton
            android:id="@+id/inter_btn_close"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            app:bigo_ad_customLayout="@layout/bigo_ad_item_inter_default_countdown_bg"/>
    </LinearLayout>

</FrameLayout>