<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inter_form_content_layout"
    android:background="#1C2933"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="100dp"
    android:layout_gravity="center_horizontal">
    <TextView
        android:id="@+id/inter_form_content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textSize="20sp"
        android:textColor="#DAE6F2"
        android:layout_marginTop="16dp"/>
    <TextView
        android:id="@+id/inter_form_content_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/inter_form_content_title"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textSize="15.5sp"
        android:textColor="#8595A6"
        android:layout_marginTop="12dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@id/inter_form_content_description"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="27.5dp"
        android:background="#3A4A59"/>
</RelativeLayout>